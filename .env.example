# ─────────────────────────────────────────────────────────────
# LendLoop environment variables template
# Copy this file to `.env.local` for local development.
# ─────────────────────────────────────────────────────────────

# Next.js Client & Clerk Auth
NEXT_PUBLIC_CONVEX_URL=https://<your-deployment-name>.convex.cloud
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder

# Convex Environment Variables (set via `npx convex env set <KEY> <VAL>`)
CLERK_JWT_ISSUER_DOMAIN=https://<your-clerk-domain>.clerk.accounts.dev
ADMIN_EMAILS=admin@lendloop.local

# Outbound & Inbound Automation Secrets (Convex <-> n8n)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/lendloop-request-events
N8N_SIGNING_SECRET=dev_signing_secret_12345678
N8N_API_SECRET=dev_api_secret_12345678

# Local n8n Orchestrator (docker-compose)
N8N_ENCRYPTION_KEY=lendloop_secret_encryption_key_change_me_in_prod
NODE_FUNCTION_ALLOW_BUILTIN=crypto
CONVEX_SITE_URL=https://<your-deployment-name>.convex.site
ALERT_WEBHOOK_URL=
