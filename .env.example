# ─────────────────────────────────────────────────────────────
# LendLoop environment variables — NAMES ONLY, no values.
# Copy this file to `.env.local` and fill in real values.
# Never commit the filled-in file.
# ─────────────────────────────────────────────────────────────

# Next.js (public, safe to expose to the browser)
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Next.js server only (never prefixed with NEXT_PUBLIC)
CLERK_SECRET_KEY=

# Convex environment variables (set via `convex env` or dashboard)
CLERK_JWT_ISSUER_DOMAIN=
ADMIN_EMAILS=
N8N_WEBHOOK_URL=
N8N_SIGNING_SECRET=
N8N_API_SECRET=

# n8n self-hosted (docker-compose)
N8N_ENCRYPTION_KEY=
NODE_FUNCTION_ALLOW_BUILTIN=crypto
